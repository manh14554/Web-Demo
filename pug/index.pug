doctype html 
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Index 
        link(rel="stylesheet" href="../css/style.css")
        link(rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-brands/css/uicons-brands.css")
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css")
        link(href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&display=swap" rel="stylesheet")
    body 
        header.site-header
            .header-left
                .btn-menu(onclick="toggleMenu()")
                    i.fa-solid.fa-bars
                ul.menu-list#menu 
                    li 
                        a(href="./index.html") Products 
                    li 
                        a(href="./cart.html") Shopping Cart 
                    li 
                        a(href="./about.html") About
                    li
                        a(href="./login.html") Login
            .header-center
                a.logo(href="./index.html")
                    | Swag
                    span Labs
            .header-right 
                .shopping-cart
                    a(href="./cart.html") 
                        i.fa-solid.fa-cart-shopping
                        span.cart-number 1
        main.site-main
            .sub-header 
                h2.title Products 
                .sort-container 
                    i.fa-solid.fa-filter.sort-icon
                    i.fa-sharp.fa-solid.fa-caret-down.caret-icon
                    i.bi.bi-filter.sort-icon-menu 
                    select(name="product-sort" onchange="sortProduct()")
                        option(value="az") Name(A to Z)
                        option(value="za") Name(Z to A)
                        option(value="highlow") Price(High to Low)  
                        option(value="lowhigh") Price(Low to High)
            .main-product-grid 
                .main-item(data-id="balo" onclick="goToProductDetail('balo')")
                    .item-img-container
                        img.item-img(src="../images/balo.png" alt="Swag Labs Backpack")
                    .item-detail
                        .item-top 
                            a.item-name(href="product-detail.html?id=balo")  Swag Labs Backpack
                            .item-desc Carry all the things with the sleek, streamlined Sly Pack that melds uncompromising style with unequaled laptop and tablet protection.
                        .item-price-container 
                            span.item-price $29.99
                            button.btn1.btn-add-to-cart Add to Cart
                .main-item(data-id="den" onclick="goToProductDetail('den')")
                    .item-img-container
                        img.item-img(src="../images/den.png" alt="Bike Lights")
                    .item-detail
                        .item-top 
                            a.item-name(href="product-detail.html?id=den") Bike Lights
                            .item-desc A red light isn't the desired state in testing but it sure helps when riding your bike at night. Water-resistant with 3 lighting modes, 1 AAA battery included.
                        .item-price-container 
                            span.item-price $9.99
                            button.btn1.btn-add-to-cart Add to Cart
                .main-item(data-id="ao-thun" onclick="goToProductDetail('ao-thun')")
                    .item-img-container
                        img.item-img(src="../images/ao-thun.png" alt="Bolt T-Shirt")
                    .item-detail
                        .item-top 
                            a.item-name(href="product-detail.html?id=ao-thun")  Bolt T-Shirt                                
                            .item-desc Get your testing superhero on with the Swag Labs bolt T-shirt. From American Apparel, 100% ringspun combed cotton, heather gray with white print.
                        .item-price-container
                            span.item-price $15.99
                            button.btn1.btn-add-to-cart Add to Cart
                .main-item(data-id="ao-khoac" onclick="goToProductDetail('ao-khoac')")
                    .item-img-container
                        img.item-img(src="../images/ao-khoac.png" alt="Swag Labs Fleece Jacket")
                    .item-detail
                        .item-top 
                            a.item-name(href="product-detail.html?id=ao-khoac")  Swag Labs Fleece Jacket
                            .item-desc It's not every day that you come across a midweight quarter-zip fleece jacket capable of handling everything from a relaxing day outdoors to a busy day at the office.
                        .item-price-container 
                            span.item-price $29.99
                            button.btn1.btn-remove-inventory Remove
                .main-item(data-id="ao" onclick="goToProductDetail('ao')")
                    .item-img-container
                        img.item-img(src="../images/ao.png" alt="Swag Labs Onesie")
                    .item-detail
                        .item-top 
                            a.item-name(href="product-detail.html?id=ao")  Swag Labs Onesie
                            .item-desc Rib snap infant onesie for the junior automation engineer in development. Reinforced 3-snap bottom closure, two-needle hemmed sleeved and bottom won't unravel.
                        .item-price-container 
                            span.item-price $19.99
                            button.btn1.btn-add-to-cart Add to Cart 
                .main-item(data-id="ao-len" onclick="goToProductDetail('ao-len')")
                    .item-img-container
                        img.item-img(src="../images/ao-len.png" alt="Red Long Sleeve T-Shirt")
                    .item-detail
                        .item-top 
                            a.item-name(href="product-detail.html?id=ao-len")  Red Long Sleeve T-Shirt
                            .item-desc This classic Swag Labs t-shirt is perfect to wear when cozying up to your keyboard to automate a few tests. Super-soft and comfy ringspun combed cotton.
                        .item-price-container 
                            span.item-price $29.99
                            button.btn1.btn-add-to-cart Add to Cart
        footer.site-footer
            ul.footer-link
                li 
                    a(href="#")
                        i.fa-brands.fa-twitter
                li 
                    a(href="#")
                        i.fa-brands.fa-facebook-f
                li 
                    a(href="#")
                        i.fa-brands.fa-linkedin-in
            .footer-copyright 
                p © 2026 Swag Labs. All Rights Reserved. Terms of Service | Privacy Policy
        script(src="../script/cart.js")
        script(src="../script/product.js")
        script(src="../script/menu.js")

        script. 
            document.querySelectorAll(".btn-add-to-cart").forEach(btn => {
                btn.addEventListener("click", function(e) {
                    e.stopPropagation();
                    const card = this.closest(".main-item");
                    const id = card.dataset.id;
                    addToCart(id);
                });
            });

            document.querySelectorAll(".btn-remove-inventory").forEach(btn => {
                btn.addEventListener("click", function(e) {
                    e.stopPropagation();

                    const card = this.closest(".main-item");
                    const id = card.dataset.id;
                    removeCart(id);
                });
            });
            function removeCart(id){
                const item = document.querySelector(`[data-id="${id}"]`);
                    if(item){
                        item.remove();
                    }
                }

            function goToProductDetail(id){
                window.location.href = `product-detail.html?id=${id}`;
            }

            function sortProduct() {
                const sortSelect = document.querySelector('select[name="product-sort"]');
                    if (!sortSelect) {
                        return;
                    }

                const sortValue = sortSelect.value;
                const items = Array.from(document.querySelectorAll(".main-item"));

                items.sort((a, b) => {
                    const nameA = a.querySelector(".item-name").innerText.toUpperCase();
                    const nameB = b.querySelector(".item-name").innerText.toUpperCase();
                    const priceA = parseFloat(a.querySelector(".item-price").innerText.replace("$", ""));
                    const priceB = parseFloat(b.querySelector(".item-price").innerText.replace("$", ""));

                    if (sortValue === "az") {
                        return nameA.localeCompare(nameB);
                    }
                    if (sortValue === "za") {
                        return nameB.localeCompare(nameA);
                    }
                    if (sortValue === "highlow") {
                        return priceB - priceA;
                    }
                    if (sortValue === "lowhigh") {
                        return priceA - priceB;
                    }

                    return 0;
                });

                const container = document.querySelector(".main-product-grid");
                items.forEach((item) => container.appendChild(item));
            }