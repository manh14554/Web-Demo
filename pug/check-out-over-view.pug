doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Check Out: Over View
        link(rel="stylesheet" href="../css/style.css")
        link(rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-brands/css/uicons-brands.css")
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
        link(href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&display=swap" rel="stylesheet")
    body 
        header.site-header
            .header-left
                .btn-menu(onclick="toggleMenu()")
                    i.fa-solid.fa-bars
                ul.menu-list#menu
                    li 
                        a(href="./index.html") Products
                    li 
                        a(href="./cart.html") Shopping Cart
                    li 
                        a(href="./about.html") About
                    li
                        a(href="./login.html") Login
            .header-center
                a.logo(href="./index.html")
                    | Swag
                    span Labs
            .header-right
                .shopping-cart
                    a(href="./cart.html") 
                        i.fa-solid.fa-cart-shopping
        main.site-main-overview 
            .cart-title 
                h2 Checkout: Overview
            .site-main-wrapper 
                .site-main-content
                    .site-main-item-section 
                        .site-main-list-qty-desc 
                            span.qty-label QTY
                            span.desc-label Description
                        #site-main-overview-item
                        template#overview-item-template
                            .overview-item 
                                .item-qty(data-qty)
                                .cart-item-details 
                                    .cart-item-name(data-name)
                                    p.cart-item-desc-overview(data-description)
                                    .cart-item-price(data-prices)
                                        span(data-price)
                    .summary-info
                        .info-group 
                            h3 Payment Information
                            p SwagCard ending with 1337
                        .info-group 
                            h3 Shipping Infomation 
                            p#shipping-user-info Free Pony Express Delivery 
                        .info-group.price-summary 
                            h3 Price Total 
                            .price-summary-details 
                                p Item total: 
                                    span#item-total $0.00
                                p Tax: 
                                    span#tax-total $0.00
                        .total-line 
                            h3 Total: 
                                span#grand-total $0.00
                    .button-group-overview 
                        button.btn-finish(type="button" onclick="handleFinish()") Finish
                        button.btn-cancel-overview(type="button" onclick="handleCancel()") Cancel
        footer.site-footer
            ul.footer-link
                li 
                    a(href="#")
                        i.fa-brands.fa-twitter
                li 
                    a(href="#")
                        i.fa-brands.fa-facebook-f
                li 
                    a(href="#")
                        i.fa-brands.fa-linkedin-in
            .footer-copyright 
                p © 2026 Swag Labs. All Rights Reserved. Terms of Service | Privacy Policy
        script(src="../script/cart.js")
        script(src="../script/product.js")
        script(src="../script/menu.js")
        script.
            function renderOverview() {
                const cartItems = getCartItems();
                const container = document.getElementById("site-main-overview-item");
                const template = document.getElementById("overview-item-template");

                if (!container || !template) {
                    return;
                }

                if (cartItems.length === 0) {
                    container.innerHTML = "<p>Giỏ hàng trống</p>";
                    return;
                }

                container.innerHTML = ""; // Clear container
                let itemTotal = 0;

                cartItems.forEach((item) => {
                    itemTotal += item.price * item.quantity;
                    const clone = template.content.cloneNode(true);
                    clone.querySelector("[data-qty]").textContent = item.quantity;
                    clone.querySelector("[data-name]").textContent = item.name;
                    clone.querySelector("[data-description]").textContent = item.description || "Product description";
                    clone.querySelector("[data-price]").textContent = "$" + item.price.toFixed(2);

                    container.appendChild(clone);
                });

                const taxAmount = itemTotal * 0.1;
                const grandTotal = itemTotal + taxAmount;

                document.getElementById("item-total").innerText = "$" + itemTotal.toFixed(2);
                document.getElementById("tax-total").innerText = "$" + taxAmount.toFixed(2);
                document.getElementById("grand-total").innerText = "$" + grandTotal.toFixed(2);
            }

            function handleFinish() {
                localStorage.removeItem("myCart");
                localStorage.removeItem("checkoutInfo");
                window.location.href = "./check-out-complete.html";
            }

            function handleCancel() {
                window.location.href = "./cart.html";
            }
            renderOverview();