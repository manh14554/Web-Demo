doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Check Out
        link(rel="stylesheet" href="../css/style.css")
        link(rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-brands/css/uicons-brands.css")
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
        link(href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&display=swap" rel="stylesheet")
    body 
        header.site-header
            .header-left
                .btn-menu(onclick="toggleMenu()")
                    i.fa-solid.fa-bars
                ul.menu-list#menu
                    li 
                        a(href="./index.html") Products
                    li 
                        a(href="./cart.html") Shopping Cart
                    li 
                        a(href="./index.html") About
                    li
                        a(href="./login.html") Login
            .header-center
                a.logo(href="./index.html")
                    | Swag
                    span Labs
            .header-right
                .shopping-cart
                    a(href="./cart.html") 
                        i.fa-solid.fa-cart-shopping
        main.site-main-checkout
            .cart-title 
                h2 Checkout: Your Information
            .checkout-content-wrapper
                .form-container
                    form.checkout-form#userInfoForm
                        .input-group 
                            input#firstName(type="text" placeholder="First Name" required)
                        .input-group
                            input#lastName(type="text" placeholder="Last Name" required)
                        .input-group 
                            input#zipCode(type="text" placeholder="Zip Postal Code" required)
                .divider-line 
                    hr.divider
                .button-group 
                    button.btn-continue-checkout(type="button" onclick="handleContinue()") Continue
                    button.btn-cancel-checkout(type="button" onclick="handleCancel()") Cancel
        footer.site-footer
            ul.footer-link
                li 
                    a(href="#")
                        i.fa-brands.fa-twitter
                li 
                    a(href="#")
                        i.fa-brands.fa-facebook-f
                li 
                    a(href="#")
                        i.fa-brands.fa-linkedin-in
            .footer-copyright 
                p © 2026 Swag Labs. All Rights Reserved. Terms of Service | Privacy Policy
        script(src="../script/cart.js")
        script(src="../script/product.js")
        script(src="../script/menu.js")
        script.
            function handleContinue() {
                const firstName = document.getElementById('firstName').value.trim();
                const lastName = document.getElementById('lastName').value.trim();
                const zipCode = document.getElementById('zipCode').value.trim();

                if(firstName === '' || lastName === '' || zipCode === '') {
                    alert('Vui lòng nhập thông tin người dùng.');
                    return;
                }

                const userInfo = { 
                    firstName: firstName, 
                    lastName: lastName, 
                    zipCode: zipCode };
                    localStorage.setItem('checkoutInfo', JSON.stringify(userInfo));
                    window.location.href = './check-out-over-view.html';
            }
            function handleCancel() {
                window.location.href = './cart.html';
            }