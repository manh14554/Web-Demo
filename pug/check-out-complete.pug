doctype html 
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Cart 
        link(rel="stylesheet" href="../css/style.css")
        link(rel="stylesheet" href="https://cdn-uicons.flaticon.com/uicons-brands/css/uicons-brands.css")
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css")
        link(href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&display=swap" rel="stylesheet")
    body.check-out-complete-page 
        header.site-header
            .header-left
                .btn-menu(onclick="toggleMenu()")
                    i.fa-solid.fa-bars
                ul.menu-list#menu
                    li 
                        a(href="./index.html") Products
                    li 
                        a(href="./cart.html") Shopping Cart
                    li 
                        a(href="./index.html") About
                    li
                        a(href="./login.html") Login
            .header-center
                a.logo(href="./index.html")
                    | Swag
                    span Labs
            .header-right
                .shopping-cart
                    a(href="./cart.html") 
                        i.fa-solid.fa-cart-shopping
        main.site-complete 
            .cart-title 
                h2 Checkout: Complete!
            .complete-content 
                .site-complete-icon
                    i.bi.bi-check2-circle 
                .site-complete-message 
                    h3 Thank you for your order!
                    p Your order has been dispatched, and will arrive just as fast as the pony can get there.
                .site-complete-button-back
                    button.btn-back-home(type="button" onclick="window.location.href='./index.html'") Back to Shop 
        footer.site-footer
            ul.footer-link
                li 
                    a(href="#")
                        i.fa-brands.fa-twitter
                li 
                    a(href="#")
                        i.fa-brands.fa-facebook-f
                li 
                    a(href="#")
                        i.fa-brands.fa-linkedin-in
            .footer-copyright 
                p © 2026 Swag Labs. All Rights Reserved. Terms of Service | Privacy Policy
        script(src="../script/cart.js")
        script(src="../script/menu.js")
