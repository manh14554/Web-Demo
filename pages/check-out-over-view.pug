doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Check Out: Over View
        include ../components/Link/link.pug
    body 
        include ../components/Header/header.pug
        main.site-main-overview 
            .cart-title 
                h2 Checkout: Overview
            .site-main-wrapper 
                .site-main-content
                    .site-main-item-section 
                        .site-main-list-qty-desc 
                            span.qty-label QTY
                            span.desc-label Description
                        #site-main-overview-item
                        template#overview-item-template
                            .overview-item 
                                .item-qty(data-qty)
                                .cart-item-details 
                                    .cart-item-name(data-name)
                                    p.cart-item-desc-overview(data-description)
                                    .cart-item-price(data-prices)
                                        span(data-price)
                    .summary-info
                        .info-group 
                            h3 Payment Information
                            p SwagCard ending with 1337
                        .info-group 
                            h3 Shipping Infomation 
                            p#shipping-user-info Free Pony Express Delivery 
                        .info-group.price-summary 
                            h3 Price Total 
                            .price-summary-details 
                                p Item total: 
                                    span#item-total $0.00
                                p Tax: 
                                    span#tax-total $0.00
                        .total-line 
                            h3 Total: 
                                span#grand-total $0.00
                    .button-group-overview 
                        button.btn-finish(type="button" onclick="handleFinish()") Finish
                        button.btn-cancel-overview(type="button" onclick="handleCancel()") Cancel
        include ../components/Footer/footer.pug
        script(src="../script/web/cart.js")
        script(src="../script/web/product.js")
        script(src="../script/web/check-out-overview.js")